{
  "id": "two-hand",
  "name": "双手作业分析图",
  "engine": "vue-component",
  "component": "TwoHandChart.vue",
  "styles": [
    {
      "id": "modern",
      "name": "新版 · 圆点连线",
      "description": "4 符号圆点连线风格，简洁直观",
      "component": "TwoHandChart.vue",
      "promptFile": "prompt.md",
      "previewImage": "/template-previews/two-hand-modern.png"
    },
    {
      "id": "classic",
      "name": "经典 · 符号表格",
      "description": "5 符号图标表格风格，含时间列和布局图",
