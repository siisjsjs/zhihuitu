  "exportFormats": ["xlsx", "png"],
  "supportAI": true,
  "sortOrder": 5,
  "version": "2.0.0",
  "dataSchema": {
    "headerInfo": {
      "stationName": { "type": "string", "label": "工站名称" },
      "improvement": { "type": "enum", "label": "改善现场", "options": ["现行", "改善"] },
      "startState": { "type": "string", "label": "开始状态" },
      "endState": { "type": "string", "label": "结束状态" },
      "researcher": { "type": "string", "label": "研究者" },
      "date": { "type": "date", "label": "日期" },
      "method": { "type": "string", "label": "作业方式" }
    },
    "steps": {
      "type": "array",
      "label": "作业步骤",
      "item": {
        "leftDesc": { "type": "string", "label": "左手描述" },
        "leftSymbol": { "type": "enum", "label": "左手符号", "options": ["operation", "transport", "delay", "hold"] },
        "rightSymbol": { "type": "enum", "label": "右手符号", "options": ["operation", "transport", "delay", "hold"] },
        "rightDesc": { "type": "string", "label": "右手描述" }
      }
    }
  },
  "paramSchema": {
    "headerInfo": {
      "type": "object",
      "label": "表头信息",
      "fields": {
        "stationName": { "type": "string", "label": "工站名称" },
        "improvement": { "type": "enum", "label": "改善现场", "options": ["现行", "改善"] },
        "startState": { "type": "string", "label": "开始状态（作业前的状态描述）" },
        "endState": { "type": "string", "label": "结束状态（作业完成后的状态描述）" },
        "researcher": { "type": "string", "label": "研究者" },
        "date": { "type": "string", "label": "日期(YYYY-MM-DD)" },
        "method": { "type": "string", "label": "作业方式" }
      }
    },
    "steps": {
      "type": "array<object>",
      "label": "作业步骤（按作业顺序排列，每行为左右手同时进行的一个步骤）",
      "required": true,
      "item": {
        "leftDesc": { "type": "string", "label": "左手动作描述", "required": true },
        "leftSymbol": { "type": "enum", "label": "左手符号：operation=○操作，transport=→搬运，delay=D等待，hold=▽持握", "options": ["operation", "transport", "delay", "hold"], "required": true },
        "rightSymbol": { "type": "enum", "label": "右手符号：operation=○操作，transport=→搬运，delay=D等待，hold=▽持握", "options": ["operation", "transport", "delay", "hold"], "required": true },
        "rightDesc": { "type": "string", "label": "右手动作描述", "required": true }
      }
    }
  },
