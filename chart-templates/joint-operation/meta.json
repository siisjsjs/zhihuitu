            "col2": { "desc": "保持顶升", "duration": 0.5, "isWork": true },
            "col3": { "desc": "安装新轮胎", "duration": 0.5, "isWork": true },
            "col4": { "desc": "搬走旧轮胎", "duration": 0.5, "isWork": true }
          }
        },
        {
          "time": 2.5,
          "cells": {
            "col1": { "desc": "放下前部", "duration": 0.5, "isWork": true },
