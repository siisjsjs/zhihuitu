{
  "id": "joint-operation",
  "name": "联合作业分析图",
  "engine": "vue-component",
  "component": "JointOperation.vue",
  "category": "方法研究",
  "description": "分析多人或人机组合的联合作业过程，优化协作效率",
  "tags": ["联合作业", "方法研究", "IE"],
  "exportFormats": ["xlsx", "png"],
  "supportAI": true,
  "sortOrder": 4,
  "version": "1.0.0",
  "dataSchema": {
    "headerInfo": {
      "taskName": { "type": "string", "label": "作业名称" },
      "operator": { "type": "string", "label": "操作者" },
      "date": { "type": "date", "label": "日期" },
      "location": { "type": "string", "label": "地点" },
      "remarks": { "type": "string", "label": "备注" }
    },
    "columns": {
      "type": "array",
      "label": "操作者列",
      "item": {
        "id": { "type": "string", "label": "列ID" },
        "name": { "type": "string", "label": "操作者名称" }
      }
    },
    "timeRows": {
      "type": "array",
      "label": "时间行",
      "item": {
        "time": { "type": "number", "label": "时间点(秒)" },
        "cells": { "type": "object", "label": "各列单元格" }
      }
    }
  },
  "paramSchema": {
    "headerInfo": {
      "type": "object",
      "label": "表头信息",
      "fields": {
        "taskName": { "type": "string", "label": "作业名称" },
        "operator": { "type": "string", "label": "操作者/团队名称" },
        "date": { "type": "string", "label": "日期(YYYY-MM-DD)" },
        "location": { "type": "string", "label": "作业地点" },
        "remarks": { "type": "string", "label": "备注" }
      }
    },
    "columns": {
      "type": "array<object>",
      "label": "作业者/机器列（至少 1 列）",
      "required": true,
      "item": {
        "id": { "type": "string", "label": "列ID（如 col1、col2，必须与 timeRows[].cells 的键一一对应）", "required": true },
        "name": { "type": "string", "label": "作业者或机器名称", "required": true }
      }
    },
    "timeRows": {
      "type": "array<object>",
      "label": "时间行（按时间递增排列，每行代表一个时间段的结束时间点）",
      "required": true,
      "item": {
        "time": { "type": "number", "label": "累计时间点(秒)，如 0.5、1.0、1.5", "required": true },
        "cells": {
          "type": "object",
          "label": "各列在该时间段的单元格，键为列ID（如 col1）",
          "required": true,
          "item": {
            "desc": { "type": "string", "label": "动作描述", "required": true },
            "duration": { "type": "number", "label": "该段持续时间(秒)", "required": true },
            "isWork": { "type": "boolean", "label": "是否为工作状态（true=工作，false=空闲/等待）", "required": true }
          }
        }
      }
    }
  },
  "example": {
    "description": "下面是一个F1汽车轮胎更换的联合作业分析示例。包含前后千斤顶操作员、轮胎枪手、搬运工等多人协作过程，展示各操作者的工作/空闲状态。",
    "data": {
      "headerInfo": {
        "taskName": "F1汽车轮胎更换",
        "operator": "换胎团队",
        "date": "2024-03-20",
